% Macro to print stats with autocomputed modifier
% e.g. \stat{12} prints "12 (+1)"
\newcommand{\stat}[1]{%
	\FPeval{\mod}{(#1 - 10)/2}%
	\FPifpos\mod%
	\FPeval{\mod}{clip(trunc(mod,0))}#1\ (+\mod)%
	\else%
	\FPeval{\mod}{clip(abs(trunc(mod-0.5,0)))}#1\ (\(-\)\mod)%
	\fi%
}

% Macro to print average dice based value
% e.g. \rpgdice{2d6+3} prints "10 (2d6 + 3)"
\newcommand{\rpgdice}[1]{%
	\StrSubstitute{#1}{ }{}[\DiceArg]%
	\StrCut{\DiceArg}{d}\DiceNum\DiceSides%
	\StrCut{\DiceSides}{+}\DiceSides\DiceAddMod%
	\StrCut{\DiceSides}{-}\DiceSides\DiceSubMod%
	\FPeval{\DiceAvg}{(\DiceSides+1)/2*\DiceNum}%
	\IfInteger{\DiceAddMod}{%
		\FPadd{\DiceAvg}{\DiceAvg}{\DiceAddMod}%
		\def\DiceMod{ + \DiceAddMod}%
	}{%
		\IfInteger{\DiceSubMod}{%
			\FPsub{\DiceAvg}{\DiceAvg}{\DiceSubMod}%
			\def\DiceMod{ \(-\) \DiceSubMod}%
		}{%
			\def\DiceMod{}%
		}%
	}%
	\FPtrunc{\DiceAvg}{\DiceAvg}{0}%
	\FPprint{\DiceAvg\ (\DiceNum d\DiceSides\DiceMod)}%
}

% Monster box made to look like the Monster Manual NPC definitions
\newtcolorbox{monsterboxnobg}[2][]{
	enhanced,
	frame hidden,
	boxrule=0pt,
	breakable,
	boxsep=0pt,
	toptitle=3mm,
	left=0pt,
	right=0pt,
	arc=0mm,
	opacityback=0,
	colframe=title1,
	fonttitle=\rpg@StatBlockTitleFont\Large,
	fontupper=\rpg@StatBlockBodyFont,
	title=#2,
	coltitle=title1,
	#1
}

% Stat block made to look like stat blocks in the PHB.
\newtcolorbox{monsterboxbg}[2][]{
  enhanced,
  frame hidden,
  before skip=7pt plus 2pt,
  boxrule=0pt,
  breakable,
  boxsep=0pt,
  toptitle=11pt,
  left=7pt,
  right=7pt,
  bottom=11pt,
  arc=0mm,
  oversize=0pt,
  borderline north={4pt}{0pt}{title1},
  borderline north={2.5pt}{0.75pt}{statblockribbon},
  borderline south={4pt}{0pt}{title1},
  borderline south={2.5pt}{0.75pt}{statblockribbon},
  colback=statblockbg,
  colbacktitle=statblockbg,
  colframe=title1,
  fonttitle=\rpg@StatBlockTitleFont\Large,
  coltitle=title1,
  fontupper=\rpg@StatBlockBodyFont,
  title=#2,
  #1
}

\iftoggle{bool-bg}{
  \let\monsterbox\monsterboxbg%
  \let\endmonsterbox\endmonsterboxbg%
}{
  \let\monsterbox\monsterboxnobg%
  \let\endmonsterbox\endmonsterboxnobg%
}

% Define Monster subsection header style
\newcommand{\rpgmonstersection}[1]{%
  \begingroup
    \par\medskip\color{title1}
    \rpg@StatBlockSubtitleFont\large #1
    \vspace{3pt}
    \hrule height 0.6pt
    \vspace{3pt}
  \endgroup%
}

\NewDocumentEnvironment{rpg-monsteraction}{o}{%
  \IfValueTF{#1}{%
    \smallskip\emph{\textbf{#1.}}%
  }{\unskip}%
}{\par}

% A description variant used to list creature attributes.
\newlist{rpg@monsterattrs}{description}{1}
\setlist[rpg@monsterattrs]{
    before=\color{title1},
    font=\rpg@StatBlockBodyFont\textbf,
    labelsep=\widthof{ },
    noitemsep,
    nosep,
}

% A rpg@monsterattrs helper macro that always displays an attribute.
\newcommand{\rpg@monsterattr}[2]{%
  \item[#2] \commandkey{#1}
}

% A rpg@monsterattrs helper macro that displays an attribute if the user defined it.
\newcommand{\rpg@ifmonsterattr}[2]{%
  \ifcommandkey{#1}{%
    \item[#2] \commandkey{#1}
  }{}%
}

\newkeycommand\basics[armorclass=0, hitpoints=0, speed=0]{%
  \begin{rpg@monsterattrs}
    \rpg@monsterattr{armorclass}{\armorclassname}
    \rpg@monsterattr{hitpoints}{\hitpointsname}
    \rpg@monsterattr{speed}{\speedname}
  \end{rpg@monsterattrs}%
}

\newkeycommand\stats[STR=\stat{10},
                        DEX=\stat{10},
                        CON=\stat{10},
                        INT=\stat{10},
                        WIS=\stat{10},
                        CHA=\stat{10}]{%
    \begingroup
		\small\centering\color{title1}
		\resizebox{\linewidth}{\height}{%
			\begin{tabular}{cccccc}
				\rule{0pt}{3.7mm}
				\textbf{\strstatname} & \textbf{\dexstatname} & \textbf{\constatname} & \textbf{\intstatname} & \textbf{\wisstatname} & \textbf{\chastatname}\\
				\commandkey{STR} & \commandkey{DEX} & \commandkey{CON} & \commandkey{INT} & \commandkey{WIS} & \commandkey{CHA}
			\end{tabular}
		}%
		\\[0.4em]
    \endgroup
}

\newkeycommand\details[
  skills=,
  damageimmunities=,
  savingthrows=,
  conditionimmunities=,
  damageresistances=,
  damagevulnerabilities=,
  senses=---,
  languages=---,
  challenge=1,
  ]{%
  \begin{rpg@monsterattrs}
    \rpg@ifmonsterattr{savingthrows}{\savesname}
    \rpg@ifmonsterattr{skills}{\skillsname}
    \rpg@ifmonsterattr{damagevulnerabilities}{\dvulname}
    \rpg@ifmonsterattr{damageresistances}{\dresname}
    \rpg@ifmonsterattr{damageimmunities}{\dimmname}
    \rpg@ifmonsterattr{conditionimmunities}{\cimmname}
    \rpg@monsterattr{senses}{\sensesname}
    \rpg@monsterattr{languages}{\languagesname}
    \item[\challengename] \crexp{\commandkey{challenge}}
  \end{rpg@monsterattrs}%
}

\newcommand\crexp[1]{%
	\IfStrEqCase{#1}{%
		{0}{#1 (0 XP)}%
		{1/10}{0 (10 XP)}%
		{1/8}{#1 (25 XP)}%
		{1/4}{#1 (50 XP)}%
		{1/2}{#1 (100 XP)}%
		{1}{#1 (200 XP)}%
		{2}{#1 (450 XP)}%
		{3}{#1 (700 XP)}%
		{4}{#1 (1,100 XP)}%
		{5}{#1 (1,800 XP)}%
		{6}{#1 (2,300 XP)}%
		{7}{#1 (2,900 XP)}%
		{8}{#1 (3,900 XP)}%
		{9}{#1 (5,000 XP)}%
		{10}{#1 (5,900 XP)}%
		{11}{#1 (7,200 XP)}%
		{12}{#1 (8,400 XP)}%
		{13}{#1 (10,000 XP)}%
		{14}{#1 (11,500 XP)}%
		{15}{#1 (13,000 XP)}%
		{16}{#1 (15,000 XP)}%
		{17}{#1 (18,000 XP)}%
		{18}{#1 (20,000 XP)}%
		{19}{#1 (22,000 XP)}%
		{20}{#1 (25,000 XP)}%
		{21}{#1 (33,000 XP)}%
		{22}{#1 (41,000 XP)}%
		{23}{#1 (50,000 XP)}%
		{24}{#1 (62,000 XP)}%
		{25}{#1 (75,000 XP)}%
		{26}{#1 (90,000 XP)}%
		{27}{#1 (105,000 XP)}%
		{28}{#1 (120,000 XP)}%
